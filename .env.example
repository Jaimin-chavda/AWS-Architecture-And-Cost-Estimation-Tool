# Copy to .env.local and fill in. Never commit .env.local.

# --- Auth + history database (Supabase Postgres, Transaction pooler) ---
# Supabase dashboard → Connect → Transaction pooler (port 6543) connection string.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- better-auth ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Public app URL (dev: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# --- Existing keys (unchanged) ---
# GITHUB_TOKEN=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
